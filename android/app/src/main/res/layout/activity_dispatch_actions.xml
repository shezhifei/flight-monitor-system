<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- ====== Toolbar ====== -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/dispatch_title"
        app:titleTextColor="@android:color/white" />

    <!-- ====== 固定顶部摘要 ====== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/dispatchCurrentOrderSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 状态标签 -->
            <TextView
                android:id="@+id/dispatchCurrentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ====== 可滚动内容 ====== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 离线队列提示 -->
            <com.flightmonitor.mobile.ui.widget.StatusMessageView
                android:id="@+id/dispatchQueueSizeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 工单来源与回执 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/dispatchOriginBadgeView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dispatchReceiptSummaryView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- 回执进度条 -->
                    <ProgressBar
                        android:id="@+id/dispatchReceiptProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:visibility="gone" />

                    <!-- 回执分色计数 -->
                    <LinearLayout
                        android:id="@+id/dispatchReceiptCountsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/dispatchAckCountLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/status_success_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/dispatchRejCountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/status_error_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/dispatchPendCountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ack_pending_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 备注输入 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="工单备注 (可选)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/dispatchNoteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@null"
                        android:hint="@string/dispatch_note_hint"
                        android:inputType="text"
                        android:minHeight="48dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 工单选择器（多工单时显示） -->
            <TextView
                android:id="@+id/orderSelectorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="切换其他关联工单"
                android:textAppearance="@style/TextAppearance.FlightMonitorMobile.SectionEyebrow"
                android:drawableStart="@drawable/ic_pin"
                android:drawablePadding="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/orderSelectorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- ====== 异常上报（可折叠区域） ====== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleIssueSection"
                style="@style/Widget.FlightMonitorMobile.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="🚨 展开异常上报面板" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/issueSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 红色侧边条指示器 -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent"
                        android:background="@color/status_error_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="异常情况描述"
                            android:textColor="@color/status_error_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <EditText
                            android:id="@+id/dispatchIssueTitleInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chat_input"
                            android:hint="@string/dispatch_issue_title_hint"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/dispatchIssueDescriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="top"
                            android:background="@drawable/bg_chat_input"
                            android:hint="@string/dispatch_issue_desc_hint"
                            android:inputType="textMultiLine"
                            android:lines="3"
                            android:maxLines="5"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/dispatchAttachmentUrlsInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="top"
                            android:background="@drawable/bg_chat_input"
                            android:hint="@string/dispatch_attachment_urls_hint"
                            android:inputType="textMultiLine"
                            android:lines="2"
                            android:maxLines="4"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/uploadAttachmentButton"
                                style="@style/Widget.FlightMonitorMobile.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dispatch_upload_attachment" />
                            <Space
                                android:layout_width="12dp"
                                android:layout_height="1dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/clearAttachmentButton"
                                style="@style/Widget.FlightMonitorMobile.Button.Danger"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dispatch_clear_attachments" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reportIssueButton"
                            style="@style/Widget.FlightMonitorMobile.Button.Danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/dispatch_report_issue" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 工单数据视图（隐藏的原始文本，保留兼容） -->
            <TextView
                android:id="@+id/dispatchOrdersView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- 状态与进度 -->
            <com.flightmonitor.mobile.ui.widget.StatusMessageView
                android:id="@+id/dispatchStatusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <ProgressBar
                android:id="@+id/dispatchProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- 辅助按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/syncQueueButton"
                    style="@style/Widget.FlightMonitorMobile.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="同步本地操作"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ====== 固定底部主操作按钮 ====== -->
    <LinearLayout
        android:id="@+id/primaryActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/acceptOrderButton"
            style="@style/Widget.FlightMonitorMobile.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/dispatch_accept_order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkInOrderButton"
            style="@style/Widget.FlightMonitorMobile.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/dispatch_checkin_order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startOrderButton"
            style="@style/Widget.FlightMonitorMobile.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/dispatch_start_order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/etaReportButton"
            style="@style/Widget.FlightMonitorMobile.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/dispatch_eta_report"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 完工按钮和安全门禁按钮并行 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dispatchSafetyChecklistButton"
            style="@style/Widget.FlightMonitorMobile.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="🛡️"
            android:textSize="20sp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkOutOrderButton"
            style="@style/Widget.FlightMonitorMobile.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="签退"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeOrderButton"
            style="@style/Widget.FlightMonitorMobile.Button.Cta"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/dispatch_complete_order"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
