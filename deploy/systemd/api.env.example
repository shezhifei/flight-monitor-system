APP_RUNTIME_ROLE=api
APP_DISTRIBUTED_MODE=true
REDIS_REQUIRED=true
LOCAL_RUNTIME_OVERRIDES_ENABLED=false
SYSTEM_CONFIG_BACKEND=postgres
SYSTEM_CONFIG_TABLE=system_config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flight_monitor_prod
DB_USER=flight_monitor_app
DB_REPLICATION_HOST=127.0.0.1
DB_REPLICATION_PORT=5432
DB_REPLICATION_NAME=flight_monitor_prod
DB_REPLICATION_USER=fm_replicator
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
API_HOST=127.0.0.1
API_PORT=8000
# Loopback HTTP is only for same-host deployments. If Flowable is remote, use https://...
FLOWABLE_API_URL=http://127.0.0.1:8082/flowable-rest/service
FLOWABLE_ADMIN_USER=rest-admin
CORS_ALLOWED_ORIGINS=https://ops.example.com
SSE_DISTRIBUTED_ENABLED=true
MOBILE_UPLOAD_STORAGE_ROOT=/shared/mobile_uploads
VAULT_ADDR=https://127.0.0.1:8200
VAULT_ROLE_ID_FILE=/etc/flight-monitor/vault/fms-api.role_id
VAULT_SECRET_ID_FILE=/etc/flight-monitor/vault/fms-api.secret_id
VAULT_AGENT_CONFIG=/run/flight-monitor/api.vault-agent.hcl
VAULT_RENDERED_ENV_FILE=/run/flight-monitor/api.vault.env
