APP_RUNTIME_ROLE=worker
APP_DISTRIBUTED_MODE=true
REDIS_REQUIRED=true
LOCAL_RUNTIME_OVERRIDES_ENABLED=false
SYSTEM_CONFIG_BACKEND=postgres
SYSTEM_CONFIG_TABLE=system_config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flight_monitor_prod
DB_USER=flight_monitor_app
DB_REPLICATION_HOST=127.0.0.1
DB_REPLICATION_PORT=5432
DB_REPLICATION_NAME=flight_monitor_prod
DB_REPLICATION_USER=fm_replicator
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Legacy worker 通过 api-server 的 /api/v2/workflows 代理访问嵌入式 Flowable 引擎
RUST_API_BASE_URL=http://127.0.0.1:8080
# 可选：服务账号 JWT（需 workflow.* @ Common 权限），不设置则匿名调用
# RUST_API_BEARER_TOKEN=
SSE_DISTRIBUTED_ENABLED=true
MOBILE_UPLOAD_STORAGE_ROOT=/shared/mobile_uploads
VAULT_ADDR=https://127.0.0.1:8200
VAULT_ROLE_ID_FILE=/etc/flight-monitor/vault/fms-worker.role_id
VAULT_SECRET_ID_FILE=/etc/flight-monitor/vault/fms-worker.secret_id
VAULT_AGENT_CONFIG=/run/flight-monitor/worker.vault-agent.hcl
VAULT_RENDERED_ENV_FILE=/run/flight-monitor/worker.vault.env
