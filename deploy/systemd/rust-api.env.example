APP_RUNTIME_ROLE=api
API_HOST=127.0.0.1
API_PORT=8080
APP_DISTRIBUTED_MODE=true
REDIS_REQUIRED=true
LOCAL_RUNTIME_OVERRIDES_ENABLED=false
SYSTEM_CONFIG_BACKEND=postgres
SYSTEM_CONFIG_TABLE=system_config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flight_monitor_prod
DB_USER=flight_monitor_app
DB_REPLICATION_HOST=127.0.0.1
DB_REPLICATION_PORT=5432
DB_REPLICATION_NAME=flight_monitor_prod
DB_REPLICATION_USER=fm_replicator
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 嵌入式 Flowable 引擎（api-server 进程内调库，直连 flowable 库）
FLOWABLE_ENGINE_MODE=embedded
FLOWABLE_DATABASE_URL=postgresql://flowable:__REPLACE_WITH_FLOWABLE_DB_PASSWORD__@127.0.0.1:5432/flowable
FLOWABLE_DB_POOL_SIZE=8
CORS_ALLOWED_ORIGINS=https://ops.example.com
SSE_DISTRIBUTED_ENABLED=true
MOBILE_UPLOAD_STORAGE_ROOT=/shared/mobile_uploads
VAULT_ADDR=https://127.0.0.1:8200
VAULT_ROLE_ID_FILE=/etc/flight-monitor/vault/fms-rust-api.role_id
VAULT_SECRET_ID_FILE=/etc/flight-monitor/vault/fms-rust-api.secret_id
VAULT_AGENT_CONFIG=/run/flight-monitor/rust-api.vault-agent.hcl
VAULT_RENDERED_ENV_FILE=/run/flight-monitor/rust-api.vault.env
