[Unit]
Description=Flight Monitor Worker Node
After=network.target postgresql.service redis.service
Wants=network.target postgresql.service redis.service

[Service]
Type=simple
WorkingDirectory=/opt/flight-monitor-system
EnvironmentFile=/etc/flight-monitor/worker.env
EnvironmentFile=-/run/flight-monitor/worker.runtime.env
ExecStartPre=/usr/bin/mkdir -p /run/flight-monitor
ExecStartPre=/opt/flight-monitor-system/.venv/bin/python /opt/flight-monitor-system/scripts/vault/bootstrap_runtime_env.py --base-env /etc/flight-monitor/worker.env --template /opt/flight-monitor-system/deploy/vault/templates/worker.env.ctmpl --rendered-env /run/flight-monitor/worker.vault.env --runtime-env /run/flight-monitor/worker.runtime.env --agent-config /run/flight-monitor/worker.vault-agent.hcl --mode local
ExecStart=/opt/flight-monitor-system/.venv/bin/python scripts/startup/run_worker.py
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
LimitNPROC=4096
User=flight-monitor
Group=flight-monitor
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/shared /var/log/flight-monitor /run/flight-monitor
PrivateTmp=true

[Install]
WantedBy=multi-user.target
