{{ with secret "kv/data/fms/shared" -}}
DB_PASSWORD={{ index .Data.data "DB_PASSWORD" }}
DB_REPLICATION_PASSWORD={{ index .Data.data "DB_REPLICATION_PASSWORD" }}
REDIS_PASSWORD={{ index .Data.data "REDIS_PASSWORD" }}
JWT_SECRET_KEY={{ index .Data.data "JWT_SECRET_KEY" }}
JWT_SECRET={{ or (index .Data.data "JWT_SECRET") (index .Data.data "JWT_SECRET_KEY") }}
AI_CONFIG_ENCRYPTION_KEY={{ index .Data.data "AI_CONFIG_ENCRYPTION_KEY" }}
AI_QUERY_DB_PASSWORD={{ index .Data.data "AI_QUERY_DB_PASSWORD" }}
{{ end -}}
{{ with secret "kv/data/fms/flowable" -}}
FLOWABLE_DB_PASSWORD={{ index .Data.data "FLOWABLE_DB_PASSWORD" }}
{{ end -}}
FLOWABLE_ENGINE_MODE=embedded
RUST_API_BASE_URL=http://rust-api:8080
{{ with secret "kv/data/fms/api" -}}
FLIGHTAWARE_API_KEY={{ index .Data.data "FLIGHTAWARE_API_KEY" }}
{{ end -}}
{{ with secret "kv/data/fms/worker" -}}
WORKER_VERIFICATION_TOKEN={{ index .Data.data "WORKER_VERIFICATION_TOKEN" }}
{{ end -}}
{{ with secret "kv/data/fms/rust-api" -}}
RUST_ADMIN_BOOTSTRAP_TOKEN={{ index .Data.data "RUST_ADMIN_BOOTSTRAP_TOKEN" }}
{{ end -}}
