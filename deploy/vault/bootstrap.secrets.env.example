# Flight Monitor System Vault seed example
# Copy to deploy/vault/bootstrap.secrets.env and replace every placeholder value.
# Keys are grouped by Vault path prefix:
#   FMS_SHARED__*   -> kv/fms/shared
#   FMS_API__*      -> kv/fms/api
#   FMS_WORKER__*   -> kv/fms/worker
#   FMS_RUST_API__* -> kv/fms/rust-api
#   FMS_FLOWABLE__* -> kv/fms/flowable

FMS_SHARED__DB_PASSWORD=__REPLACE_WITH_DB_PASSWORD__
FMS_SHARED__DB_REPLICATION_PASSWORD=__REPLACE_WITH_DB_REPLICATION_PASSWORD__
FMS_SHARED__REDIS_PASSWORD=__REPLACE_WITH_REDIS_PASSWORD__
FMS_SHARED__JWT_SECRET_KEY=__REPLACE_WITH_JWT_SECRET_KEY__
FMS_SHARED__JWT_SECRET=__OPTIONAL_OVERRIDE_JWT_SECRET__
FMS_SHARED__AI_CONFIG_ENCRYPTION_KEY=__REPLACE_WITH_AI_CONFIG_ENCRYPTION_KEY__
FMS_SHARED__AI_QUERY_DB_PASSWORD=__OPTIONAL_AI_QUERY_DB_PASSWORD__

FMS_API__FLIGHTAWARE_API_KEY=__OPTIONAL_FLIGHTAWARE_API_KEY__

FMS_WORKER__WORKER_VERIFICATION_TOKEN=__OPTIONAL_WORKER_VERIFICATION_TOKEN__

FMS_RUST_API__RUST_ADMIN_BOOTSTRAP_TOKEN=__OPTIONAL_RUST_ADMIN_BOOTSTRAP_TOKEN__

FMS_FLOWABLE__FLOWABLE_ADMIN_PASSWORD=__REPLACE_WITH_FLOWABLE_ADMIN_PASSWORD__
FMS_FLOWABLE__FLOWABLE_DB_PASSWORD=__REPLACE_WITH_FLOWABLE_DB_PASSWORD__
FMS_FLOWABLE__FLOWABLE_PASSWORD=__OPTIONAL_OVERRIDE_FLOWABLE_PASSWORD__

