# Flight Monitor System - 边缘部署 Vault bootstrap 模板
# 敏感配置由 Vault Agent 渲染到 VAULT_RENDERED_ENV_FILE，不直接写入本文件。

APP_ENV=production
APP_RUNTIME_ROLE=api
APP_DISTRIBUTED_MODE=true
REDIS_REQUIRED=true
LOCAL_RUNTIME_OVERRIDES_ENABLED=false

# 网络配置
API_HOST=0.0.0.0
API_PORT=8080
NGINX_PORT=80
RUST_API_HOST_PORT=18080

# 数据库 / Redis 非敏感连接信息
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flight_monitor_dev
DB_USER=postgres
DB_REPLICATION_HOST=postgres
DB_REPLICATION_PORT=5432
DB_REPLICATION_NAME=flight_monitor_dev
DB_REPLICATION_USER=fm_replicator
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
SYSTEM_CONFIG_TABLE=system_config

# Flowable 与浏览器暴露面
FLOWABLE_API_URL=http://flowable:8080/flowable-rest/service
FLOWABLE_ADMIN_USER=rest-admin
CORS_ALLOWED_ORIGINS=https://ops.example.com

# 日志与边缘参数
RUST_LOG=info
RUST_BACKTRACE=1
MALLOC_ARENA_MAX=2
AI_SIDECAR_URL=http://ai-sidecar:9000
AI_SIDECAR_TIMEOUT_SECS=30
DB_POOL_MAX_CONNECTIONS=4
DB_POOL_MIN_CONNECTIONS=0
DB_POOL_ACQUIRE_TIMEOUT_SECS=30
DB_POOL_IDLE_TIMEOUT_SECS=300
DB_POOL_MAX_LIFETIME_SECS=1800
SSE_MAX_CONNECTIONS=100

# Vault bootstrap
VAULT_ADDR=https://127.0.0.1:8200
VAULT_ROLE_ID_FILE=deploy/vault/approle/fms-ops-bootstrap.role_id
VAULT_SECRET_ID_FILE=deploy/vault/approle/fms-ops-bootstrap.secret_id
VAULT_AGENT_CONFIG=deploy/docker/.vault/edge/vault-agent.hcl
VAULT_RENDERED_ENV_FILE=deploy/docker/.vault/edge/rendered.env
