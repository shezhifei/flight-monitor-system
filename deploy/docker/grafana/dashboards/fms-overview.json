{
  "schemaVersion": 39,
  "title": "FMS Overview",
  "uid": "fms-overview",
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "prometheus" },
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(fms_http_requests_total[5m])) by (route,status)",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p99 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(fms_http_request_duration_seconds_bucket[5m])) by (le,route))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "DB Pool Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "fms_db_pool_connections",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis Commands",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(fms_redis_commands_total[5m])) by (command)",
          "legendFormat": "{{command}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "MQ Publish Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(fms_mq_publish_total[5m])) by (topic)",
          "legendFormat": "publish {{topic}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "MQ Consume Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(fms_mq_consume_total[5m])) by (topic)",
          "legendFormat": "consume {{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "AI LLM Calls",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(fms_ai_llm_calls_total[5m])) by (model,status)",
          "legendFormat": "{{model}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "AI Tool Calls",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(fms_ai_tool_calls_total[5m])) by (tool,status)",
          "legendFormat": "{{tool}} {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "AI MQ Gate Decisions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(fms_ai_mq_gate_decisions_total[5m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Outbox Pending Events",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "sum(fms_outbox_pending_events)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 11,
      "title": "Outbox Publish Duration p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(fms_outbox_publish_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
