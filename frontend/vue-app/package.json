{
  "name": "flight-monitor-vue",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "test:e2e": "playwright test",
    "parity:check-legacy-root": "node scripts/parity/legacy-root.mjs",
    "parity:serve-legacy": "node scripts/parity/serve-legacy.mjs",
    "parity:test-fixtures": "vitest run src/legacy/parityFixtures.test.ts",
    "parity:extract": "node scripts/parity/extract-legacy-contract.mjs",
    "parity:report": "node scripts/parity/build-parity-report.mjs",
    "parity:capture-legacy": "node scripts/parity/capture-legacy-snapshots.mjs",
    "parity:refresh-baseline": "node scripts/parity/capture-legacy-snapshots.mjs --refresh-baseline",
    "parity:build-schema-catalog": "node scripts/parity/build-schema-catalog.mjs",
    "parity:align-evidence": "node scripts/parity/align-evidence-ids.mjs",
    "parity:capture-vue": "node scripts/parity/capture-vue-snapshots.mjs",
    "parity:refresh-vue": "node scripts/parity/capture-vue-snapshots.mjs --refresh-baseline"
  },
  "dependencies": {
    "bpmn-js": "^18.14.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "marked": "^17.0.5",
    "protobufjs": "^8.4.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^29.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.4"
  }
}
