<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FlightMonitorApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlightMonitorMobile">
        <activity
            android:name=".ui.NotificationReceiptGroupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BusinessCaseEditorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BusinessCaseDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BusinessCaseListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NotificationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CollaborationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChatGroupListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChatMessageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.SafetyChecklistActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ShiftHandoverActivity"
            android:exported="false" />
        <activity
            android:name=".ui.OperationsCenterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DispatchActionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WorkbenchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
