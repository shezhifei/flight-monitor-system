<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 拖拽指示条 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_surface" />

    <!-- 航班号 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheetFlightId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/sheetStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 工单步骤 + 工单号 -->
    <TextView
        android:id="@+id/sheetStepAndOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#1A000000" />

    <!-- 停机位 + 航站楼 -->
    <TextView
        android:id="@+id/sheetLocationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <!-- 计划时间 -->
    <TextView
        android:id="@+id/sheetPlannedTimeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <!-- 实际开始时间 -->
    <TextView
        android:id="@+id/sheetActualTimeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="@color/status_success_text"
        android:visibility="gone" />

    <!-- 分配截止时间 -->
    <TextView
        android:id="@+id/sheetDeadlineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="@color/status_warning_text"
        android:visibility="gone" />

    <!-- 主管通知 -->
    <TextView
        android:id="@+id/sheetSupervisorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <!-- 进入工单 按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetOpenOrderButton"
        style="@style/Widget.FlightMonitorMobile.Button.Cta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="进入工单" />

</LinearLayout>
