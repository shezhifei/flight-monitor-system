<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.FlightMonitorMobile.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.FlightMonitorMobile.Button.Primary" parent="Widget.FlightMonitorMobile.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/surface_card</item>
        <item name="iconTint">@color/surface_card</item>
    </style>

    <style name="Widget.FlightMonitorMobile.Button.Secondary" parent="Widget.FlightMonitorMobile.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/surface_card</item>
        <item name="iconTint">@color/surface_card</item>
    </style>

    <style name="Widget.FlightMonitorMobile.Button.Outlined" parent="Widget.FlightMonitorMobile.Button">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FlightMonitorMobile.Button.Cta" parent="Widget.FlightMonitorMobile.Button">
        <item name="backgroundTint">@color/cta</item>
        <item name="android:textColor">@color/surface_card</item>
        <item name="iconTint">@color/surface_card</item>
    </style>

    <style name="Widget.FlightMonitorMobile.Button.Danger" parent="Widget.FlightMonitorMobile.Button.Outlined">
        <item name="android:textColor">@color/status_error_text</item>
        <item name="iconTint">@color/status_error_text</item>
        <item name="strokeColor">@color/status_error_bg</item>
    </style>

    <style name="Widget.FlightMonitorMobile.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/border_subtle</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlightMonitorMobile.PageTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="TextAppearance.FlightMonitorMobile.PageSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.FlightMonitorMobile.SectionEyebrow" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="TextAppearance.FlightMonitorMobile.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.FlightMonitorMobile.CardText" parent="">
        <item name="android:background">@drawable/bg_card_surface</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Widget.FlightMonitorMobile.SoftCardText" parent="Widget.FlightMonitorMobile.CardText">
        <item name="android:background">@drawable/bg_card_soft</item>
    </style>

    <style name="Widget.FlightMonitorMobile.HeroCardText" parent="Widget.FlightMonitorMobile.CardText">
        <item name="android:background">@drawable/bg_card_hero</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Widget.FlightMonitorMobile.StatusText" parent="">
        <item name="android:background">@drawable/bg_status_info</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/status_info_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
